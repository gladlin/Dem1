<Page x:Class="Dem1.Pages.ChangePartner"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Dem1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница измнения партнера">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1">
                <TextBlock Text="Изменение данных о клиенте" Margin="5" Width="300" Height="15"/>

                <TextBlock Text="Тип партнёра" Width="300" Height="15"/>
                <ComboBox x:Name="cmbPartnerType" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="Наименование" Width="300" Height="15"/>
                <TextBox x:Name="tbPartnerName" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="ФИО директора" Width="300" Height="15"/>
                <TextBox x:Name="tbDirector" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="Адрес" Width="300" Height="15"/>
                <TextBox x:Name="tbPartnerAddress" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="Рейтинг" Width="300" Height="15"/>
                <TextBox x:Name="tbRatio" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="Телефон" Width="300" Height="15"/>
                <TextBox x:Name="tbProneNumber" Margin="5" Width="300" Height="25"/>

                <TextBlock Text="Электронная почта" Width="300" Height="15"/>
                <TextBox x:Name="tbEmail" Margin="5" Width="300" Height="25"/>

                <Button x:Name="btnSave" Background="#FF0C4882" Foreground="White"  Content="Сохранить" Margin="15" Width="150" Height="30" Click="btnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
